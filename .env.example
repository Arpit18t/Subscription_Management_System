# Database configuration
DATABASE_URL=postgresql+psycopg2://testuser:testpass@localhost:5432/brightloop
TEST_DATABASE_URL=postgresql+psycopg2://testuser:testpass@localhost:5432/brightloop_test

# Application
APP_ENV=development
APP_NAME="Brightloop Billing & Payments Engine"
DEBUG=false
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
